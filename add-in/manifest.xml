<?xml version="1.0" encoding="UTF-8"?>
<!--
  Val-Studio DCF — Excel Task Pane Add-in manifest (MVP Level 1).
  Add-in 본체는 별도 바이너리가 아니라 웹 페이지(우리 HTTPS 앱 ?embed=1).
  ⚠️ <Id> GUID 는 프로덕션 고정값(배포 후 변경 금지). 로컬 개발 사이드로딩은 manifest.dev.xml
     (별도 GUID + http://localhost:8000) 사용 — dev/prod add-in 은 서로 다른 GUID 여야 공존.
  ⚠️ URL 은 Cloud Run 실배포(단일 컨테이너 — 앱·API 동일 오리진)로 결선됨(2026-08-01).
     도메인이 바뀌면(커스텀 도메인 등) SourceLocation·AppDomain·아이콘 URL 을 함께 교체.
  상세: docs/prd_excel_addin.md §6·§19, docs/skill_excel_workflow_spec.md §3.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="TaskPaneApp">
  <Id>fad3c5ee-38a0-4a50-8b91-059839352e32</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Val-Studio</ProviderName>
  <DefaultLocale>ko-KR</DefaultLocale>
  <DisplayName DefaultValue="Val-Studio DCF"/>
  <Description DefaultValue="DCF 결정론 엔진 · 가정 타당성 검증 (Task Pane)"/>
  <IconUrl DefaultValue="https://val-studio-789315789234.asia-northeast3.run.app/logo.png"/>
  <HighResolutionIconUrl DefaultValue="https://val-studio-789315789234.asia-northeast3.run.app/logo@2x.png"/>
  <SupportUrl DefaultValue="https://github.com/gfdsstyu/val-studio"/>

  <!-- Task Pane 내 내비게이션 허용 목록. 앱·API 가 동일 오리진(Cloud Run 단일 컨테이너)이라
       도메인 1개면 충분. CORS 와 별개(동일 오리진 fetch 라 프로덕션 CORS 자체가 불요). -->
  <AppDomains>
    <AppDomain>https://val-studio-789315789234.asia-northeast3.run.app</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>

  <DefaultSettings>
    <!-- Task Pane URL = 우리 HTTPS 앱의 embed 모드(LNB·헤더 축소, FR-M2.7). -->
    <SourceLocation DefaultValue="https://val-studio-789315789234.asia-northeast3.run.app/?embed=1"/>
  </DefaultSettings>

  <!-- Level 1(Task Pane only)은 ReadDocument 로 시작. Office.js 쓰기(Level 2)부터 ReadWriteDocument. -->
  <Permissions>ReadDocument</Permissions>
</OfficeApp>
